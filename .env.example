APP_NAME="AI-Powered Website Link Analysis API"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=4000
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional alternative. Set LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=30
# Optional override. Defaults to 5000 for Claude and 3000 for OpenAI.
# LLM_MAX_OUTPUT_TOKENS=5000
LLM_MAX_CONTENT_CHARS=12000
# Optional competitor research. Use "none" to disable search.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=5
# Seconds
WEBSITE_REQUEST_TIMEOUT=10
# Bytes (2 MiB)
MAX_WEBSITE_RESPONSE_SIZE=2097152
MAX_WEBSITE_REDIRECTS=3
WEBSITE_USER_AGENT=AI-Link-Analysis/0.1
# Limits enforced when ENVIRONMENT=production
ANALYSIS_MAX_BODY_BYTES=32768
ANALYSIS_BODY_TIMEOUT_SECONDS=5
ANALYSIS_MAX_IN_FLIGHT=2
ANALYSIS_REQUESTS_PER_HOUR=20
